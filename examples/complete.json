{
  "requirements": {
    "features": [
      "Store and deliver messages"
    ],
    "prevent_duplicate_effects": true,
    "acknowledged_operation": "message_accepted",
    "survive_failures": [
      "process_crash",
      "host_loss"
    ],
    "preserve_accepted_messages": true,
    "bounded_queue_required": true,
    "latency_target_ms": 500
  },
  "design": {
    "components": [
      "HTTP API",
      "Durable replicated queue",
      "Transactional message store",
      "Worker"
    ],
    "flows": [
      "Client submits a message to the API.",
      "Worker consumes queued messages and writes business state."
    ],
    "retry": {
      "redelivery_possible": true,
      "all_effects_intrinsically_idempotent": false,
      "stable_message_id": true,
      "dedup_enforced": true,
      "dedup_atomic_with_effect": true,
      "dedup_retention_seconds": 172800,
      "max_redelivery_age_seconds": 86400,
      "external_effects": false
    },
    "acknowledgement": {
      "acknowledged_operation": "message_accepted",
      "after_durable_commit": true,
      "survives_failures": [
        "process_crash",
        "host_loss"
      ],
      "notes": "Acceptance follows a durable quorum commit on independent hosts; failover preserves committed messages."
    },
    "queue": {
      "max_messages": 10000,
      "policy": "reject_before_accept",
      "admission_before_accept": true,
      "preserves_accepted_messages": true,
      "retry_backoff": true,
      "notes": "At capacity return a retryable rejection before success; retry clients use bounded exponential backoff with jitter."
    }
  },
  "workload": {
    "average_messages_per_second": 100,
    "peak_factor": 5,
    "message_bytes": 1024,
    "average_recipients": 3,
    "retention_days": 30,
    "storage_copies_per_message": 1,
    "replication_factor": 3,
    "storage_overhead_factor": 1.2,
    "monthly_growth_fraction": 0.1,
    "growth_horizon_months": 6
  },
  "deployment": {
    "hardware": "Unknown; requires measurement",
    "topology": "Replicas on independent hosts"
  }
}
