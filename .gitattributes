* text=auto
*.py text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.csv text eol=lf
MANIFEST.in text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.sh text eol=lf
*.ps1 text eol=crlf
# Frozen experiment inputs retain their exact recorded bytes across checkouts.
datasets/backend-diagnostics-v1/* -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol

# Preserve audited upstream license/card bytes, including their original whitespace.
docs/model-licenses/* -text whitespace=-blank-at-eol,-blank-at-eof

# Preserve the published benchmark hash on every platform.
docs/benchmarks/2026-10-final-test.jsonl -text whitespace=cr-at-eol
